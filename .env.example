
# Server-only. Never prefix these with NEXT_PUBLIC_ — this app has no
# browser-side Supabase access at all. Every read/write happens in Server
# Components / Route Handlers using the service-role key, and access control
# is enforced in application code via each client's access_token, not via
# Supabase RLS policies (RLS is enabled with zero policies: default-deny).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FATHOM_WEBHOOK_SECRET=

# Text drafts (see docs/text-drafts.md)
ANTHROPIC_API_KEY=
ADMIN_ACCESS_TOKEN=
# Shared secret between the dashboard and the relay on Kegan's Mac.
# Generate with: openssl rand -hex 32
TEXTS_RELAY_TOKEN=
# Optional phone ping when a draft is ready (ntfy.sh topic name, keep it unguessable)
NTFY_TOPIC=
# Optional: where the ping links to, e.g. https://<site>/admin/<ADMIN_ACCESS_TOKEN>/texts
TEXTS_REVIEW_URL=
