
# Server-only. Never prefix these with NEXT_PUBLIC_ — this app has no
# browser-side Supabase access at all. Every read/write happens in Server
# Components / Route Handlers using the service-role key, and access control
# is enforced in application code via each client's access_token, not via
# Supabase RLS policies (RLS is enabled with zero policies: default-deny).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
